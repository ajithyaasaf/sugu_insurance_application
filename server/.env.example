# Database Configuration (PostgreSQL)
# For local PostgreSQL, you can use: postgresql://postgres:postgres@localhost:5432/insurance_crm?schema=public
# If using a hosted service like Supabase with connection pooling:
# - DATABASE_URL should point to the pooled connection (port 6543)
# - DIRECT_URL should point to the direct connection (port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insurance_crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/insurance_crm?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-token-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key"

# Client URL (CORS authorization)
CLIENT_URL="http://localhost:5173"

# Seed Admin & Staff Credentials (Used during npm run db:seed)
INITIAL_ADMIN_PASSWORD="admin_secure_password"
INITIAL_STAFF_PASSWORD="staff_secure_password"
